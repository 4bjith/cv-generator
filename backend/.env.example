# ==============================================================================
# AI CV Maker — Backend Environment Configuration Example
# ==============================================================================

# Application Environment (development, test, staging, production)
APP_NAME="AI CV Maker API"
APP_ENV=development
DEBUG=false

# API Prefixes
API_PREFIX=/api
API_V1_PREFIX=/api/v1

# Security & CORS
# Comma-separated list of allowed frontend origins (no trailing slashes)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Authentication / JWT
# Generate a strong 256-bit random key for production: `openssl rand -hex 32`
JWT_SECRET_KEY=insecure-dev-jwt-secret-key-change-in-production-1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL + asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_cv_maker
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cv_generator_test
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Server (used by Uvicorn / Docker)
HOST=0.0.0.0
PORT=8000
